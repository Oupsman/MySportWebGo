# Copy to .env next to docker-compose.yaml (or pass it with --env-file) and fill it in

# the URL users open: the API only accepts requests from it
MSW_DOMAIN=https://sport.example.com
# signs the sessions: openssl rand -base64 48
MSW_SECRET_KEY=
MSW_HTTP_PORT=8080

# --- bundled database: keep this line, set a password
COMPOSE_PROFILES=db
MSW_DBPASSWORD=

# --- external database: remove COMPOSE_PROFILES above and set
# MSW_DBHOST=postgres.example.com
# MSW_DBPORT=5432
# MSW_DBUSER=mysportweb
# MSW_DBPASSWORD=
# MSW_DBNAME=mysportweb
# disable, require, verify-ca or verify-full
# MSW_DBSSLMODE=require

# --- images: where the Woodpecker pipelines push them (the docker_repo secrets without the image name),
# after a docker login on this host; or build them here with docker compose build
MSW_REGISTRY=registry.example.com/oupsman
# latest, a short commit sha, or a version: 1.2.3, 1.2 or 1
# MSW_TAG=latest
# where the frontend repository is, to build its image
# MSW_FRONTEND_PATH=../mysportweb-vuetify
