# Copy to .env next to docker-compose.yaml (or pass it with --env-file) and fill it in

# the URL users open: the API only accepts requests from it
MSW_DOMAIN=https://sport.example.com
# signs the sessions, at least 32 bytes or the backend doesn't start: openssl rand -base64 48
MSW_SECRET_KEY=
# the proxies whose X-Forwarded-For gives the client IP (rate limits), comma separated IPs or CIDRs;
# by default the loopback and the private networks, where the frontend container is
# MSW_TRUSTED_PROXIES=
# where the elevation tiles of the altitude correction are downloaded from, at the first corrected activity
# of each 1°x1° square: AWS Terrain Tiles by default, none to only use the tiles put in the media volume (dem/)
# MSW_DEM_URL=
# where the map tiles of the thumbnails are downloaded from ({z}/{x}/{y}): OpenStreetMap by default, none for
# thumbnails without map
# MSW_MAP_TILE_URL=
MSW_HTTP_PORT=8080
# the data: media/ (FIT files, pictures...) and postgres/ (the bundled database); absolute with Portainer
# MSW_DATA_DIR=./data
# the Content-Security-Policy of the frontend: reported in the browser console only (default), or enforced
# once the console shows no "Content Security Policy" report on any page
# MSW_CSP_HEADER=Content-Security-Policy

# --- bundled database: keep this line, set a password
COMPOSE_PROFILES=db
MSW_DBPASSWORD=

# --- external database: remove COMPOSE_PROFILES above and set
# MSW_DBHOST=postgres.example.com
# MSW_DBPORT=5432
# MSW_DBUSER=mysportweb
# MSW_DBPASSWORD=
# MSW_DBNAME=mysportweb
# prefer (default: TLS when offered, no certificate check), disable, allow, require, verify-ca or
# verify-full (checks the certificate and the name of the database server)
# MSW_DBSSLMODE=verify-full

# --- images: where the Woodpecker pipelines push them (the docker_repo secrets without the image name),
# after a docker login on this host; or build them here with docker compose build
MSW_REGISTRY=registry.example.com/oupsman
# the version to deploy, of both images: X.Y.Z (see Releases in the README); a short commit sha or latest
# for a test, dev to build the images here
MSW_TAG=
# where the frontend repository is, to build its image
# MSW_FRONTEND_PATH=../mysportweb-vuetify

# --- monitoring: the metrics for Prometheus (see Monitoring in the README)
# where they are published: the docker host only by default; 0.0.0.0:9090 for a Prometheus on another machine
# MSW_METRICS_ADDRESS=127.0.0.1:9090
# the bearer token the scrapes must send (authorization in the scrape config): set it when published beyond
# the docker host, openssl rand -base64 32
# MSW_METRICS_TOKEN=

# --- backups (the backup service): where, when, how long
# the directory of the dumps of the database, to back up elsewhere with MSW_DATA_DIR/media (see the README)
# MSW_BACKUP_DIR=./backups
# MSW_BACKUP_TIME=03:30
# MSW_BACKUP_TZ=Europe/Paris
# MSW_BACKUP_KEEP_DAYS=14
# uid:gid of the user of the tool sending the backups elsewhere: the only one able to read them (a backup of
# the whole machine, Proxmox Backup..., reads them anyway)
# MSW_BACKUP_OWNER=1000:1000
# an external database: a postgres image of its major version
# MSW_BACKUP_IMAGE=postgres:16-trixie
