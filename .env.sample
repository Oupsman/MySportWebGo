DBHOST=127.0.0.1
DBNAME=mysportwebgouser
DBPASSWORD=changeme
DBPORT=5432
# TLS to the database: prefer (default: TLS when the server offers it), disable, allow, require,
# verify-ca or verify-full (an external database: verify-full checks its certificate and name)
# DBSSLMODE=prefer
DBUSER=mysportwebgo
# the origin of the frontend, the only one the API accepts (CORS)
DOMAIN=http://localhost:3000
# who may create an account: closed (default), invite or open; the first admin registers with the setup code
# logged at the start while there is none
# REGISTRATION=open
LISTEN_PORT=8080
# signs the sessions, at least 32 bytes or the server doesn't start: openssl rand -base64 48
SECRET_KEY=
# the proxies whose X-Forwarded-For gives the client IP (rate limits), comma separated IPs or CIDRs;
# by default the loopback and the private networks
# TRUSTED_PROXIES=127.0.0.1
# the elevation tiles of the altitude correction (the devices set to correct their altitudes): where they
# are kept, MEDIA/dem by default, and where the missing ones are downloaded from, the SRTM tiles of AWS
# Terrain Tiles by default ({lat}: N45, {name}: N45E005), none to only use the tiles put in DEM_DIR.
# A download only tells which 1°x1° square is needed, at the first corrected activity in it (about 12 MB).
# DEM_DIR=MEDIA/dem
# DEM_URL=https://elevation-tiles-prod.s3.amazonaws.com/skadi/{lat}/{name}.hgt.gz
# the map tiles of the thumbnails: where they are kept, MEDIA/tiles by default, and where the missing ones
# are downloaded from, OpenStreetMap by default ({z}/{x}/{y}), none to only use the tiles in MAP_TILE_DIR.
# Kept 30 days; a thumbnail needs 4 to 9 tiles, mostly the same ones for the same rides.
# MAP_TILE_DIR=MEDIA/tiles
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# gin runs in release mode by default; debug logs the routes at start
# GIN_MODE=debug
